# 앱이 접속할 DB. attendance_app 역할(함수 실행 권한만 있음)로 접속한다.
# 집 PC Supabase 를 Tailscale 로 쓸 때 예: postgres://attendance_app:비밀번호@100.67.186.67:5432/postgres
# Supabase 연결 풀러(Supavisor)를 거치면 사용자 이름이 attendance_app.<POOLER_TENANT_ID> 형식이다.
DATABASE_URL=postgres://attendance_app:dev@localhost:5432/postgres

# 마이그레이션·관리 스크립트용(postgres 관리자). 앱 서버에는 넣지 않아도 된다.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres

# 전화번호 뒷자리 대조용 HMAC 비밀값. 바꾸면 기존 명단의 대조 값이 모두 무효가 되므로 따로 백업한다.
# 생성 예: openssl rand -hex 32
STUDENT_MATCH_SECRET=dev-only-secret

# 학생 IP 를 읽을 헤더. 프록시가 덮어써 주는 헤더만 지정한다.
#   Caddy/Nginx(이 저장소 deploy/ 설정): x-real-ip
#   Cloudflare 프록시 뒤: cf-connecting-ip
#   Vercel: x-real-ip
CLIENT_IP_HEADER=x-real-ip

# 개발 서버(next dev)에서 헤더가 없을 때 쓸 IP. 운영에서는 무시된다.
DEV_CLIENT_IP=127.0.0.1

# DB SSL (원격 DB에 SSL 로 접속할 때 true)
DATABASE_SSL=false
